@echo off
setlocal
set "BAT_SELF=%~f0"
set "PHOTO_ROOT=%~1"
echo.
echo ============================================================
echo   Photo Organizer - starting, please wait for the result
echo ============================================================
echo.
echo [Step 1/2] Launching Windows PowerShell ...
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$L=[IO.File]::ReadAllLines($env:BAT_SELF,[Text.Encoding]::ASCII); $m=$L -like 'REM *'; $b=($m -replace 'REM ','') -join ''; $p=[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($b)); $t=Join-Path $env:TEMP 'photo_organizer_run.ps1'; [IO.File]::WriteAllText($t,$p,(New-Object Text.UTF8Encoding($true))); & $t"
set "PS_EXIT=%ERRORLEVEL%"
echo.
echo [Step 2/2] PowerShell finished, exit code %PS_EXIT%
echo.
echo If nothing appeared above, open the run-record txt file in
echo the target folder (or in your TEMP folder) to see what happened.
echo.
echo Press any key to close this window.
pause
exit /b %PS_EXIT%
